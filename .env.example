/PORT=3000

# Supabase (server-side service role key; never expose to the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Admin login. All three are required; admin login is disabled if any is unset.
ADMIN_USER=changeme
ADMIN_PASS=changeme
# Secret used to sign admin session tokens (use a long random string)
ADMIN_TOKEN=replace-with-a-long-random-string
