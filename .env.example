PORT=3000

# Supabase project (server-side only; never expose the secret key to the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Used by the server for the database and image storage. A legacy service-role key
# can go in SUPABASE_SERVICE_KEY instead.
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Direct Postgres connection (pooler), only needed to run schema.sql / maintenance
SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASSWORD=your-database-password
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:your-database-password@aws-0-<region>.pooler.supabase.com:6543/postgres

# Admin console login (/admin.html). All three are required; login is disabled if any is unset.
ADMIN_USER=changeme
ADMIN_PASS=changeme
# Secret used to sign admin session tokens (use a long random string)
ADMIN_TOKEN=replace-with-a-long-random-string
